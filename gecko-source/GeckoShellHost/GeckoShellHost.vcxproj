<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A7E7C4B1-D5A8-4D51-8E74-C8F860A6F113}</ProjectGuid>
    <Keyword>WindowsRuntimeComponent</Keyword>
    <RootNamespace>DesktopMode.Gecko</RootNamespace>
    <ProjectName>DesktopMode.Gecko</ProjectName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>15.0</MinimumVisualStudioVersion>
    <AppContainerApplication>true</AppContainerApplication>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.18362.0</WindowsTargetPlatformMinVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CppWinRTProjectLanguage>C++/WinRT</CppWinRTProjectLanguage>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(ProjectDir)GeckoBuild.local.props" Condition="Exists('$(ProjectDir)GeckoBuild.local.props')" />
  <PropertyGroup>
    <GeckoW10mObj Condition="'$(GeckoW10mObj)'=='' and '$(GECKO_W10M_OBJ)'!=''">$(GECKO_W10M_OBJ)</GeckoW10mObj>
    <GeckoW10mSource Condition="'$(GeckoW10mSource)'=='' and '$(GECKO_W10M_SOURCE)'!=''">$(GECKO_W10M_SOURCE)</GeckoW10mSource>
    <GeckoW10mClangCl Condition="'$(GeckoW10mClangCl)'=='' and '$(GECKO_W10M_CLANG_CL)'!=''">$(GECKO_W10M_CLANG_CL)</GeckoW10mClangCl>
    <GeckoW10mClangCl Condition="'$(GeckoW10mClangCl)'==''">clang-cl.exe</GeckoW10mClangCl>
    <GeckoW10mBin Condition="'$(GeckoW10mObj)'!=''">$(GeckoW10mObj)\dist\bin</GeckoW10mBin>
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <CppWinRTGenerateWindowsMetadata>true</CppWinRTGenerateWindowsMetadata>
    <GeneratedFilesDir>$(ProjectDir)$(Platform)\$(Configuration)\Generated Files</GeneratedFilesDir>
    <GeckoCppWinRTTool>$(WindowsSdkDir)bin\$(WindowsTargetPlatformVersion)\x64\cppwinrt.exe</GeckoCppWinRTTool>
    <GeckoWinmd>$(OutDir)DesktopMode.Gecko.winmd</GeckoWinmd>
  </PropertyGroup>
  <Import Project="$(ProjectDir)GeckoRuntimeFiles.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <GeckoW10mBootstrapFlags>/Od /MDd /D_DEBUG /D_ITERATOR_DEBUG_LEVEL=2</GeckoW10mBootstrapFlags>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'!='Debug'">
    <GeckoW10mBootstrapFlags>/O2 /MD /DNDEBUG /D_ITERATOR_DEBUG_LEVEL=0</GeckoW10mBootstrapFlags>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <CompileAsWinRT>false</CompileAsWinRT>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <AdditionalIncludeDirectories>$(ProjectDir);$(GeneratedFilesDir);$(GeneratedFilesDir)\DesktopMode\Gecko;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_WINRT_DLL;GECKO_W10M;NOMINMAX;_CRT_SECURE_NO_WARNINGS;_SILENCE_EXPERIMENTAL_COROUTINE_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(GeckoW10mObj)\dist\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>mozglue.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateWindowsMetadata>true</GenerateWindowsMetadata>
      <ModuleDefinitionFile>GeckoShellHost.def</ModuleDefinitionFile>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <Midl Include="DesktopMode.Gecko.idl" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClInclude Include="GeckoHost.h" />
    <ClInclude Include="DesktopMode.Gecko.GeckoHost.h" />
    <ClInclude Include="client\DownloadBroker.h" />
    <ClInclude Include="client\DrmBridge.h" />
    <ClInclude Include="client\EngineView.h" />
    <ClInclude Include="client\Log.h" />
    <ClInclude Include="engine\GeckoRuntimeHost.h" />
    <ClInclude Include="engine\OverlayProbe.h" />
    <ClInclude Include="engine\gecko_bootstrap.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="dllmain.cpp" />
    <ClCompile Include="GeckoHost.cpp" />
    <ClCompile Include="$(GeneratedFilesDir)\module.g.cpp" />
    <ClCompile Include="client\DownloadBroker.cpp" />
    <ClCompile Include="client\DrmBridge.cpp" />
    <ClCompile Include="client\EngineView.cpp" />
    <ClCompile Include="client\Log.cpp" />
    <ClCompile Include="engine\GeckoRuntimeHost.cpp" />
    <ClCompile Include="engine\OverlayProbe.cpp" />
    <CustomBuild Include="engine\gecko_bootstrap.cpp">
      <Command>"$(GeckoW10mClangCl)" --target=x86_64-pc-windows-msvc /nologo /c "%(FullPath)" /Fo:"$(IntDir)gecko_bootstrap_$(Configuration).obj" /std:c++20 /EHs-c- /GR- $(GeckoW10mBootstrapFlags) /Zl /utf-8 /DWIN32 /D_WIN32 /DWIN64 /DNOMINMAX /DUNICODE /D_UNICODE /DWINAPI_FAMILY=WINAPI_FAMILY_DESKTOP_APP /DXP_WIN /DGECKO_W10M=1 /I"$(GeckoW10mObj)\dist\include" /I"$(GeckoW10mSource)\toolkit\components\startup"</Command>
      <Outputs>$(IntDir)gecko_bootstrap_$(Configuration).obj</Outputs>
      <!-- The embedded host binary itself may be unchanged while the external
           Gecko/ANGLE runtime was rebuilt. Treat the core runtime binaries as
           real inputs so Visual Studio does not mark the project (and then the
           Shell package layout) up to date while AppX still contains old DLLs. -->
      <AdditionalInputs>$(GeckoW10mObj)\dist\include\mozilla-config.h;$(GeckoW10mBin)\xul.dll;$(GeckoW10mBin)\libEGL.dll;$(GeckoW10mBin)\libGLESv2.dll;%(AdditionalInputs)</AdditionalInputs>
      <Message>Compiling embedded Gecko bootstrap with clang-cl</Message>
    </CustomBuild>
  </ItemGroup>
  <ItemGroup>
    <!-- Also expose every curated payload file to Visual Studio's fast
         up-to-date check. CollectGeckoRuntimeOutputs remains the only package
         transport, so these inputs do not enter PRI or create duplicates. -->
    <UpToDateCheckInput Include="@(GeckoRuntimeFile)" />
    <UpToDateCheckInput Include="$(GeckoW10mBin)\application.ini" />
  </ItemGroup>
  <ItemGroup>
    <None Include="GeckoShellHost.def" />
  </ItemGroup>
  <ItemGroup>
    <SDKReference Include="Microsoft.VCLibs.Desktop, Version=14.0" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="GenerateGeckoCppWinRT"
          AfterTargets="Midl"
          BeforeTargets="ClCompile"
          DependsOnTargets="Midl"
          Inputs="$(ProjectDir)DesktopMode.Gecko.idl;$(GeckoWinmd)"
          Outputs="$(GeneratedFilesDir)\module.g.cpp;$(GeneratedFilesDir)\GeckoHost.g.h;$(GeneratedFilesDir)\GeckoHost.g.cpp;$(GeneratedFilesDir)\winrt\DesktopMode.Gecko.h">
    <MakeDir Directories="$(GeneratedFilesDir)" />
    <Exec Command="&quot;$(GeckoCppWinRTTool)&quot; -input &quot;$(GeckoWinmd)&quot; -reference $(WindowsTargetPlatformVersion) -output &quot;$(GeneratedFilesDir)&quot; -component -optimize" />
  </Target>
  <PropertyGroup>
    <BuiltProjectOutputGroupDependsOn>
      $(BuiltProjectOutputGroupDependsOn);
      CollectGeckoRuntimeOutputs
    </BuiltProjectOutputGroupDependsOn>
  </PropertyGroup>
  <Target Name="ValidateGeckoBuildConfiguration">
    <Error Condition="'$(GeckoW10mObj)'==''" Text="GeckoW10mObj is not configured. Copy GeckoBuild.local.props.example to GeckoBuild.local.props or set GECKO_W10M_OBJ." />
    <Error Condition="'$(GeckoW10mSource)'==''" Text="GeckoW10mSource is not configured. Copy GeckoBuild.local.props.example to GeckoBuild.local.props or set GECKO_W10M_SOURCE." />
    <Error Condition="'$(GeckoW10mObj)'!='' and !Exists('$(GeckoW10mObj)\dist\include\mozilla-config.h')" Text="The Gecko object directory '$(GeckoW10mObj)' is incomplete: dist\include\mozilla-config.h was not found." />
    <Error Condition="'$(GeckoW10mSource)'!='' and !Exists('$(GeckoW10mSource)\toolkit\components\startup')" Text="The Gecko source directory '$(GeckoW10mSource)' is invalid: toolkit\components\startup was not found." />
    <Error Condition="'$(GeckoW10mBin)'!='' and !Exists('$(GeckoW10mBin)\xul.dll')" Text="The Gecko runtime at '$(GeckoW10mBin)' is incomplete: xul.dll was not found." />
    <Error Condition="'$(GeckoW10mBin)'!='' and !Exists('$(GeckoW10mBin)\application.ini')" Text="The Gecko runtime at '$(GeckoW10mBin)' is incomplete: application.ini was not found." />
  </Target>
  <Target Name="CollectGeckoRuntimeOutputs" DependsOnTargets="ValidateGeckoBuildConfiguration">
    <ItemGroup>
      <_GeckoApplicationIni Include="$(GeckoW10mBin)\application.ini" />
      <_BuiltProjectOutputGroupOutputIntermediate Include="@(GeckoRuntimeFile->'%(FullPath)')">
        <FinalOutputPath>%(GeckoRuntimeFile.FullPath)</FinalOutputPath>
        <TargetPath>%(GeckoRuntimeFile.TargetPath)</TargetPath>
      </_BuiltProjectOutputGroupOutputIntermediate>
      <_BuiltProjectOutputGroupOutputIntermediate Include="@(_GeckoApplicationIni->'%(FullPath)')">
        <FinalOutputPath>%(_GeckoApplicationIni.FullPath)</FinalOutputPath>
        <TargetPath>application.ini</TargetPath>
      </_BuiltProjectOutputGroupOutputIntermediate>
      <_BuiltProjectOutputGroupOutputIntermediate Include="@(_GeckoApplicationIni->'%(FullPath)')" KeepDuplicates="true">
        <FinalOutputPath>%(_GeckoApplicationIni.FullPath)</FinalOutputPath>
        <TargetPath>browser\application.ini</TargetPath>
      </_BuiltProjectOutputGroupOutputIntermediate>
    </ItemGroup>
  </Target>
</Project>
