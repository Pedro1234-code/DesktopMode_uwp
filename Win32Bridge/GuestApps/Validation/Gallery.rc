#include <windows.h>
101 DIALOGEX 0, 0, 230, 91
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Win32 resource dialog"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Type here. Try Tab, Enter, Escape and the close button.", -1, 8, 8, 214, 12
    EDITTEXT 200, 8, 26, 214, 15, ES_AUTOHSCROLL
    AUTOCHECKBOX "Toggle", 201, 8, 48, 80, 12
    DEFPUSHBUTTON "OK", IDOK, 111, 65, 52, 15
    PUSHBUTTON "Cancel", IDCANCEL, 170, 65, 52, 15
END
