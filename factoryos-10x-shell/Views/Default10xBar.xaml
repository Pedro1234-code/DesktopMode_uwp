<Page
    x:Class="factoryos_10x_shell.Views.Default10xBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:factoryos_10x_shell.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    MaxHeight="50"
    mc:Ignorable="d">

    <Page.Resources>
        <BitmapImage x:Key="TaskViewDefaultIcon" UriSource="ms-appx:///taskview.png" />
        <BitmapImage x:Key="TaskViewHoverIcon" UriSource="ms-appx:///Assets/TaskView/taskview-hover.png" />
        <Style x:Key="TaskViewButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="TaskViewBackground" Background="{TemplateBinding Background}">
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><ScaleTransform x:Name="TaskViewIconScale" /></Grid.RenderTransform>
                                    <Image x:Name="TaskViewDefaultImage" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{StaticResource TaskViewDefaultIcon}" Stretch="Uniform" />
                                    <Image x:Name="TaskViewHoverImage" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Source="{StaticResource TaskViewHoverIcon}" Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TaskViewBackground" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" /></ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="TaskViewDefaultImage" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewHoverImage" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewIconScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewIconScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TaskViewBackground" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#34343333" /></ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="TaskViewDefaultImage" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewHoverImage" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewIconScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewIconScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TaskViewBackground" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#55343333" /></ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="TaskViewDefaultImage" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.06" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewHoverImage" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewIconScale" Storyboard.TargetProperty="ScaleX" To="0.8" Duration="0:0:0.06" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewIconScale" Storyboard.TargetProperty="ScaleY" To="0.8" Duration="0:0:0.06" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <LinearGradientBrush x:Key="TopLeftStartCorner" MappingMode="RelativeToBoundingBox" StartPoint="0.654087007045746,1.38681995868683" EndPoint="4.19095993041992,4.92368984222412">
            <LinearGradientBrush.GradientStops>
                <GradientStopCollection>
                    <GradientStop Color="#03A5F0" />
                    <GradientStop Offset="1" Color="#1389D0" />
                </GradientStopCollection>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BottomLeftStartCorner" MappingMode="RelativeToBoundingBox" StartPoint="0.376727014780045,5.06757020950317" EndPoint="4.43623018264771,9.12707042694092">
            <LinearGradientBrush.GradientStops>
                <GradientStopCollection>
                    <GradientStop Color="#0462B6" />
                    <GradientStop Offset="1" Color="#00479D" />
                </GradientStopCollection>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TopRightStartCorner" MappingMode="RelativeToBoundingBox" StartPoint="4.70152997970581,0.700914025306702" EndPoint="10.1199998855591,4.78404998779297">
            <LinearGradientBrush.GradientStops>
                <GradientStopCollection>
                    <GradientStop Color="#00D8FD" />
                    <GradientStop Offset="1" Color="#0AB9EE" />
                </GradientStopCollection>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BottomRightStartCorner" MappingMode="RelativeToBoundingBox" StartPoint="4.97241020202637,4.94214010238647" EndPoint="9.93787002563477,9.90760040283203">
            <LinearGradientBrush.GradientStops>
                <GradientStopCollection>
                    <GradientStop Color="#04A8F3" />
                    <GradientStop Offset="1" Color="#0081CE" />
                </GradientStopCollection>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid
        x:Name="TaskbarGrid"
        Height="50"
        VerticalAlignment="Bottom"
        Background="{ThemeResource TaskbarAcrylicBrush}">

        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <Button
                x:Name="StartButton"
                Width="50"
                Height="50"
                Padding="13"
                HorizontalAlignment="Center"
                Background="Transparent"
                Command="{x:Bind Mode=OneWay, Path=ViewModel.StartButtonClickedCommand}"
                CornerRadius="0"
                ToolTipService.ToolTip="Start">
                <Viewbox>
                    <Canvas
                        x:Name="StartCanvas"
                        Width="1024"
                        Height="1024">
                        <Path
                            x:Name="NormalTopLeft"
                            Data="M427.866 95.189V495.289H16.0659L16.0659 150.5C16.0659 150.5 9.79999 150.8 62 145C114.2 139.2 427.866 95.189 427.866 95.189Z"
                            Fill="{x:Bind ViewModel.ThemedIconBrush, Mode=OneWay}"
                            Opacity="{x:Bind ViewModel.StartNormalOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15" />
                            </Path.OpacityTransition>
                        </Path>
                        <Path
                            x:Name="NormalBottomLeft"
                            Data="M427.866 929.589V529.489H16.0659L16.0659 874.5C16.0659 874.5 12.1659 874.489 64.3659 880.289C116.666 886.089 427.866 929.589 427.866 929.589Z"
                            Fill="{x:Bind ViewModel.ThemedIconBrush, Mode=OneWay}"
                            Opacity="{x:Bind ViewModel.StartNormalOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15" />
                            </Path.OpacityTransition>
                        </Path>
                        <Path
                            x:Name="NormalTopRight"
                            Data="M461.966 91.289V495.289H1007.07L1005.5 12.5C1005.5 12.5 1003.17 13.089 947.166 20.789C891.166 28.489 461.966 91.289 461.966 91.289Z"
                            Fill="{x:Bind ViewModel.ThemedIconBrush, Mode=OneWay}"
                            Opacity="{x:Bind ViewModel.StartNormalOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.25" />
                            </Path.OpacityTransition>
                        </Path>
                        <Path
                            x:Name="NormalBottomRight"
                            Data="M461.966 933.489V529.489H1007.07V1011.5C1007.07 1011.5 1003.17 1011.79 947.166 1004.09C891.166 996.289 461.966 933.489 461.966 933.489Z"
                            Fill="{x:Bind ViewModel.ThemedIconBrush, Mode=OneWay}"
                            Opacity="{x:Bind ViewModel.StartNormalOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.30" />
                            </Path.OpacityTransition>
                        </Path>
                        <Path
                            x:Name="ColorTopLeft"
                            Data="M427.866 95.189V495.289H16.0659L16.0659 150.5C16.0659 150.5 9.79999 150.8 62 145C114.2 139.2 427.866 95.189 427.866 95.189Z"
                            Fill="{StaticResource TopLeftStartCorner}"
                            Opacity="{x:Bind ViewModel.StartColorOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15" />
                            </Path.OpacityTransition>
                        </Path>
                        <Path
                            x:Name="ColorBottomLeft"
                            Data="M427.866 929.589V529.489H16.0659L16.0659 874.5C16.0659 874.5 12.1659 874.489 64.3659 880.289C116.666 886.089 427.866 929.589 427.866 929.589Z"
                            Fill="{StaticResource BottomLeftStartCorner}"
                            Opacity="{x:Bind ViewModel.StartColorOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.20" />
                            </Path.OpacityTransition>
                        </Path>
                        <Path
                            x:Name="ColorTopRight"
                            Data="M461.966 91.289V495.289H1007.07L1005.5 12.5C1005.5 12.5 1003.17 13.089 947.166 20.789C891.166 28.489 461.966 91.289 461.966 91.289Z"
                            Fill="{StaticResource TopRightStartCorner}"
                            Opacity="{x:Bind ViewModel.StartColorOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.25" />
                            </Path.OpacityTransition>
                        </Path>
                        <Path
                            x:Name="ColorBottomRight"
                            Data="M461.966 933.489V529.489H1007.07V1011.5C1007.07 1011.5 1003.17 1011.79 947.166 1004.09C891.166 996.289 461.966 933.489 461.966 933.489Z"
                            Fill="{StaticResource BottomRightStartCorner}"
                            Opacity="{x:Bind ViewModel.StartColorOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.30" />
                            </Path.OpacityTransition>
                        </Path>
                    </Canvas>
                </Viewbox>
            </Button>

            <Button
                x:Name="TaskViewButton"
                Click="TaskViewButton_Click"
                Style="{StaticResource TaskViewButtonStyle}"
                ToolTipService.ToolTip="Task View" />

            <StackPanel
                x:Name="PinnedAppsPanel"
                Margin="0,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal" />
            <StackPanel
                x:Name="OpenWebAppsPanel"
                Margin="0,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal" />
            <StackPanel
                x:Name="OpenWin32AppsPanel"
                Margin="0,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal" />
            <StackPanel x:Name="OpenFilesPanel" VerticalAlignment="Center" Orientation="Horizontal" />
            <StackPanel
                x:Name="PinnedWebAppsPanel"
                Margin="0,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal" />


        </StackPanel>
        <StackPanel
            x:Name="RightControls"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                x:Name="ActionCenterButton"
                Width="75"
                Height="50"
                Padding="0"
                Command="{x:Bind Mode=OneWay, Path=ViewModel.ActionCenterButtonClickedCommand}"
                Style="{StaticResource TaskbarButtonStyle}"
                ToolTipService.ToolTip="Action Center">
                <Grid
                    Width="75"
                    Height="50"
                    Padding="0">
                    <TextBlock
                        x:Name="ClockText2"
                        Margin="5,5,10,5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        FontWeight="Medium"
                        Foreground="{x:Bind Mode=OneWay, Path=ViewModel.ThemedIconBrush}"
                        Text="{x:Bind Mode=OneWay, Path=ViewModel.TimeText}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock
                            x:Name="NotifStatus2"
                            Margin="0,0,5,7"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="{x:Bind Mode=OneWay, Path=ViewModel.ThemedIconBrush}"
                            Text="&#xEC42;"
                            Visibility="Visible" />
                        <TextBlock
                            x:Name="BattStatus2"
                            Margin="0,0,4,6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Foreground="{x:Bind Mode=OneWay, Path=ViewModel.ThemedIconBrush}"
                            Text="{x:Bind Mode=OneWay, Path=ViewModel.BatteryStatusCharacter}"
                            Visibility="{x:Bind Mode=OneWay, Path=ViewModel.BattStatusVisibility}" />
                        <Grid>
                            <TextBlock
                                x:Name="WifiStatusBackground2"
                                Margin="{x:Bind Mode=OneWay, Path=ViewModel.NetworkStatusMargin}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="{x:Bind Mode=OneWay, Path=ViewModel.ThemedIconBrush}"
                                Opacity="0.4"
                                Text="{x:Bind Mode=OneWay, Path=ViewModel.NetworkStatusBackground}" />
                            <TextBlock
                                x:Name="WifiStatus2"
                                Margin="{x:Bind Mode=OneWay, Path=ViewModel.NetworkStatusMargin}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="{x:Bind Mode=OneWay, Path=ViewModel.ThemedIconBrush}"
                                Text="{x:Bind Mode=OneWay, Path=ViewModel.NetworkStatusCharacter}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</Page>
