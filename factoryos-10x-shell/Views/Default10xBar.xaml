<Page
    x:Class="factoryos_10x_shell.Views.Default10xBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:factoryos_10x_shell.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    MaxHeight="50"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="Windows11TaskbarAppStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" Margin="2,3">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundElement.Background" Value="{ThemeResource Windows11TaskbarHoverFill}" />
                                            <Setter Target="BackgroundElement.BorderBrush" Value="{ThemeResource Windows11TaskbarHoverStroke}" />
                                            <Setter Target="MultiWindowElement.Background" Value="{ThemeResource Windows11TaskbarHoverFill}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundElement.Background" Value="{ThemeResource Windows11ItemPressedFill}" />
                                            <Setter Target="BackgroundElement.BorderBrush" Value="{ThemeResource Windows11TaskbarPressedStroke}" />
                                            <Setter Target="MultiWindowElement.Background" Value="{ThemeResource Windows11ItemPressedFill}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Icon.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="WindowGroupStates">
                                    <VisualState x:Name="SingleWindow" />
                                    <VisualState x:Name="MultipleWindows">
                                        <VisualState.Setters>
                                            <Setter Target="MultiWindowElement.Visibility" Value="Visible" />
                                            <Setter Target="BackgroundElement.Margin" Value="0,0,4,0" />
                                            <Setter Target="ActivePlate.Margin" Value="0,0,4,0" />
                                            <Setter Target="Icon.Margin" Value="0,0,4,0" />
                                            <Setter Target="RunningIndicator.Margin" Value="0,0,4,3" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="RunningIndicatorStates">
                                    <VisualState x:Name="ClosedApp" />
                                    <VisualState x:Name="InactiveApp">
                                        <VisualState.Setters>
                                            <Setter Target="RunningIndicator.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="ActiveApp">
                                        <VisualState.Setters>
                                            <Setter Target="RunningIndicator.Visibility" Value="Visible" />
                                            <Setter Target="RunningIndicator.Width" Value="16" />
                                            <Setter Target="RunningIndicator.Fill" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="MultiWindowElement" Width="9" HorizontalAlignment="Right"
                                    CornerRadius="0,4,4,0" Visibility="Collapsed" IsHitTestVisible="False"
                                    BorderThickness="0,1,1,1" BorderBrush="{ThemeResource Windows11TaskbarHoverStroke}"
                                    Background="{ThemeResource Windows11ItemHoverFill}">
                                <Border.BackgroundTransition><BrushTransition Duration="0:0:0.083" /></Border.BackgroundTransition>
                            </Border>
                            <Border x:Name="ActivePlate" CornerRadius="{TemplateBinding CornerRadius}"
                                    Background="{ThemeResource Windows11ItemHoverFill}" Visibility="Collapsed"
                                    BorderBrush="{ThemeResource Windows11TaskbarHoverStroke}" BorderThickness="1"
                                    IsHitTestVisible="False" />
                            <Border x:Name="BackgroundElement" CornerRadius="{TemplateBinding CornerRadius}"
                                    Background="Transparent" BorderThickness="1" IsHitTestVisible="False">
                                <Border.BackgroundTransition><BrushTransition Duration="0:0:0.083" /></Border.BackgroundTransition>
                            </Border>
                            <ContentPresenter x:Name="Icon" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Rectangle x:Name="RunningIndicator" Width="6" Height="3" RadiusX="1.5" RadiusY="1.5"
                                       Margin="0,0,0,3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Fill="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Windows11TaskbarSearchStyle" TargetType="local:Windows11SearchButton">
            <Setter Property="Height" Value="48" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:Windows11SearchButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.07" />
                                        <VisualTransition From="Pressed" GeneratedDuration="0:0:0.18">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <VisualTransition GeneratedDuration="0:0:0.12" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Target="InteractionPlate.Opacity" Value="0" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="InteractionPlate.Opacity" Value="1" />
                                            <Setter Target="InteractionPlate.Background" Value="{ThemeResource Windows11TaskbarHoverFill}" />
                                            <Setter Target="InteractionPlate.BorderBrush" Value="{ThemeResource Windows11TaskbarHoverStroke}" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="InteractionPlate.Opacity" Value="1" />
                                            <Setter Target="InteractionPlate.Background" Value="{ThemeResource Windows11ItemPressedFill}" />
                                            <Setter Target="InteractionPlate.BorderBrush" Value="{ThemeResource Windows11TaskbarPressedStroke}" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="0.85" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="0.85" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="SearchContent.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SearchDisplayStates">
                                    <VisualState x:Name="SearchIcon" />
                                    <VisualState x:Name="SearchBox">
                                        <VisualState.Setters>
                                            <Setter Target="SearchContent.Height" Value="32" />
                                            <Setter Target="BackgroundElement.CornerRadius" Value="16" />
                                            <Setter Target="InteractionPlate.CornerRadius" Value="16" />
                                            <Setter Target="BackgroundElement.Opacity" Value="1" />
                                            <Setter Target="IconHost.HorizontalAlignment" Value="Left" />
                                            <Setter Target="IconHost.Margin" Value="12,0,0,0" />
                                            <Setter Target="SearchIconImage.Visibility" Value="Collapsed" />
                                            <Setter Target="SearchBoxFontIcon.Visibility" Value="Visible" />
                                            <Setter Target="SearchBoxTextBlock.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="SearchContent" Height="40" Margin="2,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Border x:Name="BackgroundElement" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}"
                                        BorderThickness="1" BorderBrush="{ThemeResource Windows11TaskbarHoverStroke}"
                                        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" />
                                <Border x:Name="InteractionPlate" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}"
                                        BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                                    <Border.BackgroundTransition><BrushTransition Duration="0:0:0.083" /></Border.BackgroundTransition>
                                    <Border.OpacityTransition><ScalarTransition Duration="0:0:0.083" /></Border.OpacityTransition>
                                </Border>
                                <Grid x:Name="IconHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5" AutomationProperties.AccessibilityView="Raw">
                                    <Grid.RenderTransform><ScaleTransform x:Name="IconScale" /></Grid.RenderTransform>
                                    <Image x:Name="SearchIconImage" Width="24" Height="24" Stretch="Uniform"
                                           Source="{ThemeResource Windows11TaskbarSearchGlyph}" />
                                    <FontIcon x:Name="SearchBoxFontIcon" Glyph="&#xF78B;" FontSize="16"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              Foreground="{TemplateBinding Foreground}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="SearchBoxTextBlock" Text="Search" Margin="37,0,16,1" FontSize="14"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"
                                           VerticalAlignment="Center" Visibility="Collapsed"
                                           AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Windows11LaunchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.07" />
                                        <VisualTransition From="Pressed" GeneratedDuration="0:0:0.18">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <VisualTransition GeneratedDuration="0:0:0.12" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0.65" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="0.80" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="0.80" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconPresenter" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HoverPlate" Width="40" Height="40" CornerRadius="4" Opacity="0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                    Background="{ThemeResource Windows11TaskbarHoverFill}"
                                    BorderBrush="{ThemeResource Windows11TaskbarHoverStroke}" BorderThickness="1" />
                            <ContentPresenter x:Name="IconPresenter" Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform x:Name="IconScale" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BitmapImage x:Key="TaskViewDefaultIcon" UriSource="ms-appx:///taskview.png" />
        <BitmapImage x:Key="TaskViewHoverIcon" UriSource="ms-appx:///Assets/TaskView/taskview-hover.png" />
        <Style x:Key="TaskViewButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="TaskViewBackground" Background="{TemplateBinding Background}">
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><ScaleTransform x:Name="TaskViewIconScale" /></Grid.RenderTransform>
                                    <Image x:Name="TaskViewDefaultImage" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{StaticResource TaskViewDefaultIcon}" Stretch="Uniform" />
                                    <Image x:Name="TaskViewHoverImage" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Source="{StaticResource TaskViewHoverIcon}" Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TaskViewBackground" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" /></ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="TaskViewDefaultImage" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewHoverImage" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewIconScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewIconScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TaskViewBackground" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#34343333" /></ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="TaskViewDefaultImage" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewHoverImage" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewIconScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewIconScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TaskViewBackground" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#55343333" /></ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="TaskViewDefaultImage" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.06" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewHoverImage" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewIconScale" Storyboard.TargetProperty="ScaleX" To="0.8" Duration="0:0:0.06" />
                                            <DoubleAnimation Storyboard.TargetName="TaskViewIconScale" Storyboard.TargetProperty="ScaleY" To="0.8" Duration="0:0:0.06" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <LinearGradientBrush x:Key="TopLeftStartCorner" MappingMode="RelativeToBoundingBox" StartPoint="0.654087007045746,1.38681995868683" EndPoint="4.19095993041992,4.92368984222412">
            <LinearGradientBrush.GradientStops>
                <GradientStopCollection>
                    <GradientStop Color="#03A5F0" />
                    <GradientStop Offset="1" Color="#1389D0" />
                </GradientStopCollection>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BottomLeftStartCorner" MappingMode="RelativeToBoundingBox" StartPoint="0.376727014780045,5.06757020950317" EndPoint="4.43623018264771,9.12707042694092">
            <LinearGradientBrush.GradientStops>
                <GradientStopCollection>
                    <GradientStop Color="#0462B6" />
                    <GradientStop Offset="1" Color="#00479D" />
                </GradientStopCollection>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TopRightStartCorner" MappingMode="RelativeToBoundingBox" StartPoint="4.70152997970581,0.700914025306702" EndPoint="10.1199998855591,4.78404998779297">
            <LinearGradientBrush.GradientStops>
                <GradientStopCollection>
                    <GradientStop Color="#00D8FD" />
                    <GradientStop Offset="1" Color="#0AB9EE" />
                </GradientStopCollection>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BottomRightStartCorner" MappingMode="RelativeToBoundingBox" StartPoint="4.97241020202637,4.94214010238647" EndPoint="9.93787002563477,9.90760040283203">
            <LinearGradientBrush.GradientStops>
                <GradientStopCollection>
                    <GradientStop Color="#04A8F3" />
                    <GradientStop Offset="1" Color="#0081CE" />
                </GradientStopCollection>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid
        x:Name="TaskbarGrid"
        Height="50"
        VerticalAlignment="Bottom"
        Background="Transparent">

        <Border x:Name="Windows10XTaskbarPlate" Background="{ThemeResource TaskbarAcrylicBrush}" IsHitTestVisible="False" />
        <Border x:Name="Windows11TaskbarPlate" Background="{ThemeResource Windows11TaskbarAcrylic}"
                BorderThickness="0,1,0,0" IsHitTestVisible="False" Visibility="Collapsed" />
        <StackPanel x:Name="TaskbarButtons" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button
                x:Name="StartButton"
                Width="50"
                Height="50"
                Padding="13"
                HorizontalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Command="{x:Bind Mode=OneWay, Path=ViewModel.StartButtonClickedCommand}"
                CornerRadius="0"
                FocusVisualPrimaryThickness="0"
                FocusVisualSecondaryThickness="0"
                UseSystemFocusVisuals="False"
                ToolTipService.ToolTip="Start">
                <Viewbox>
                    <Canvas
                        x:Name="StartCanvas"
                        Width="1024"
                        Height="1024">
                        <Path
                            x:Name="NormalTopLeft"
                            Data="M427.866 95.189V495.289H16.0659L16.0659 150.5C16.0659 150.5 9.79999 150.8 62 145C114.2 139.2 427.866 95.189 427.866 95.189Z"
                            Fill="{x:Bind ViewModel.ThemedIconBrush, Mode=OneWay}"
                            Opacity="{x:Bind ViewModel.StartNormalOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15" />
                            </Path.OpacityTransition>
                        </Path>
                        <Path
                            x:Name="NormalBottomLeft"
                            Data="M427.866 929.589V529.489H16.0659L16.0659 874.5C16.0659 874.5 12.1659 874.489 64.3659 880.289C116.666 886.089 427.866 929.589 427.866 929.589Z"
                            Fill="{x:Bind ViewModel.ThemedIconBrush, Mode=OneWay}"
                            Opacity="{x:Bind ViewModel.StartNormalOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15" />
                            </Path.OpacityTransition>
                        </Path>
                        <Path
                            x:Name="NormalTopRight"
                            Data="M461.966 91.289V495.289H1007.07L1005.5 12.5C1005.5 12.5 1003.17 13.089 947.166 20.789C891.166 28.489 461.966 91.289 461.966 91.289Z"
                            Fill="{x:Bind ViewModel.ThemedIconBrush, Mode=OneWay}"
                            Opacity="{x:Bind ViewModel.StartNormalOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.25" />
                            </Path.OpacityTransition>
                        </Path>
                        <Path
                            x:Name="NormalBottomRight"
                            Data="M461.966 933.489V529.489H1007.07V1011.5C1007.07 1011.5 1003.17 1011.79 947.166 1004.09C891.166 996.289 461.966 933.489 461.966 933.489Z"
                            Fill="{x:Bind ViewModel.ThemedIconBrush, Mode=OneWay}"
                            Opacity="{x:Bind ViewModel.StartNormalOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.30" />
                            </Path.OpacityTransition>
                        </Path>
                        <Path
                            x:Name="ColorTopLeft"
                            Data="M427.866 95.189V495.289H16.0659L16.0659 150.5C16.0659 150.5 9.79999 150.8 62 145C114.2 139.2 427.866 95.189 427.866 95.189Z"
                            Fill="{StaticResource TopLeftStartCorner}"
                            Opacity="{x:Bind ViewModel.StartColorOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15" />
                            </Path.OpacityTransition>
                        </Path>
                        <Path
                            x:Name="ColorBottomLeft"
                            Data="M427.866 929.589V529.489H16.0659L16.0659 874.5C16.0659 874.5 12.1659 874.489 64.3659 880.289C116.666 886.089 427.866 929.589 427.866 929.589Z"
                            Fill="{StaticResource BottomLeftStartCorner}"
                            Opacity="{x:Bind ViewModel.StartColorOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.20" />
                            </Path.OpacityTransition>
                        </Path>
                        <Path
                            x:Name="ColorTopRight"
                            Data="M461.966 91.289V495.289H1007.07L1005.5 12.5C1005.5 12.5 1003.17 13.089 947.166 20.789C891.166 28.489 461.966 91.289 461.966 91.289Z"
                            Fill="{StaticResource TopRightStartCorner}"
                            Opacity="{x:Bind ViewModel.StartColorOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.25" />
                            </Path.OpacityTransition>
                        </Path>
                        <Path
                            x:Name="ColorBottomRight"
                            Data="M461.966 933.489V529.489H1007.07V1011.5C1007.07 1011.5 1003.17 1011.79 947.166 1004.09C891.166 996.289 461.966 933.489 461.966 933.489Z"
                            Fill="{StaticResource BottomRightStartCorner}"
                            Opacity="{x:Bind ViewModel.StartColorOpacity, Mode=OneWay}">
                            <Path.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.30" />
                            </Path.OpacityTransition>
                        </Path>
                    </Canvas>
                </Viewbox>
            </Button>
            <Button x:Name="Windows11StartButton" Visibility="Collapsed" Style="{StaticResource Windows11LaunchButtonStyle}"
                    AutomationProperties.Name="Start" ToolTipService.ToolTip="Start"
                    Command="{x:Bind Mode=OneWay, Path=ViewModel.StartButtonClickedCommand}">
                <Image Width="24" Height="24" Source="{ThemeResource Windows11StartGlyph}" Stretch="Uniform" />
            </Button>

            <local:Windows11SearchButton x:Name="Windows11TaskbarSearch" Visibility="Collapsed"
                                         Style="{StaticResource Windows11TaskbarSearchStyle}"
                                         Foreground="{x:Bind ViewModel.ThemedIconBrush, Mode=OneWay}"
                                         AllowFocusOnInteraction="False" AutomationProperties.Name="Search" ToolTipService.ToolTip="Search"
                                         Click="Windows11TaskbarSearch_Click" />

            <Button
                x:Name="TaskViewButton"
                Click="TaskViewButton_Click"
                Style="{StaticResource TaskViewButtonStyle}"
                ToolTipService.ToolTip="Task View" />
            <Button x:Name="Windows11TaskViewButton" Visibility="Collapsed" Style="{StaticResource Windows11LaunchButtonStyle}"
                    AutomationProperties.Name="Task View" ToolTipService.ToolTip="Task View" Click="TaskViewButton_Click">
                <Image Width="24" Height="24" Source="{ThemeResource Windows11TaskViewGlyph}" Stretch="Uniform" />
            </Button>

            <StackPanel
                x:Name="PinnedAppsPanel"
                Margin="0,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal" />
            <StackPanel
                x:Name="OpenWebAppsPanel"
                Margin="0,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal" />
            <StackPanel
                x:Name="OpenWin32AppsPanel"
                Margin="0,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal" />
            <StackPanel x:Name="OpenFilesPanel" VerticalAlignment="Center" Orientation="Horizontal" />
            <StackPanel
                x:Name="PinnedWebAppsPanel"
                Margin="0,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal" />


        </StackPanel>
        <StackPanel
            x:Name="RightControls"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button x:Name="Windows11QuickSettingsButton" Visibility="Collapsed" Height="42" MinWidth="58"
                    CornerRadius="6" Background="Transparent" BorderThickness="0" Padding="7,0"
                    ToolTipService.ToolTip="Quick settings"
                    Command="{x:Bind Mode=OneWay, Path=ViewModel.ActionCenterButtonClickedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{x:Bind Mode=OneWay, Path=ViewModel.ThemedIconBrush}"
                               Text="{x:Bind Mode=OneWay, Path=ViewModel.NetworkStatusCharacter}" />
                    <FontIcon Glyph="&#xE767;" FontSize="14"
                              Foreground="{x:Bind Mode=OneWay, Path=ViewModel.ThemedIconBrush}" />
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{x:Bind Mode=OneWay, Path=ViewModel.ThemedIconBrush}"
                               Text="{x:Bind Mode=OneWay, Path=ViewModel.BatteryStatusCharacter}"
                               Visibility="{x:Bind Mode=OneWay, Path=ViewModel.BattStatusVisibility}" />
                </StackPanel>
            </Button>
            <Button
                x:Name="ActionCenterButton"
                Width="75"
                Height="50"
                Padding="0"
                Command="{x:Bind Mode=OneWay, Path=ViewModel.ActionCenterButtonClickedCommand}"
                Style="{StaticResource TaskbarButtonStyle}"
                ToolTipService.ToolTip="Action Center">
                <Grid
                    x:Name="TrayLayout"
                    Width="75"
                    Height="50"
                    Padding="0">
                    <TextBlock x:Name="Windows11TrayDate" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,8,5" FontSize="11" Foreground="{x:Bind Mode=OneWay, Path=ViewModel.ThemedIconBrush}" Visibility="Collapsed" />
                    <TextBlock
                        x:Name="ClockText2"
                        Margin="5,5,10,5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        FontWeight="Medium"
                        Foreground="{x:Bind Mode=OneWay, Path=ViewModel.ThemedIconBrush}"
                        Text="{x:Bind Mode=OneWay, Path=ViewModel.TimeText}" />
                    <StackPanel x:Name="TrayStatusIcons" HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock
                            x:Name="NotifStatus2"
                            Margin="0,0,5,7"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="{x:Bind Mode=OneWay, Path=ViewModel.ThemedIconBrush}"
                            Text="&#xEC42;"
                            Visibility="Visible" />
                        <TextBlock
                            x:Name="BattStatus2"
                            Margin="0,0,4,6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Foreground="{x:Bind Mode=OneWay, Path=ViewModel.ThemedIconBrush}"
                            Text="{x:Bind Mode=OneWay, Path=ViewModel.BatteryStatusCharacter}"
                            Visibility="{x:Bind Mode=OneWay, Path=ViewModel.BattStatusVisibility}" />
                        <Grid>
                            <TextBlock
                                x:Name="WifiStatusBackground2"
                                Margin="{x:Bind Mode=OneWay, Path=ViewModel.NetworkStatusMargin}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="{x:Bind Mode=OneWay, Path=ViewModel.ThemedIconBrush}"
                                Opacity="0.4"
                                Text="{x:Bind Mode=OneWay, Path=ViewModel.NetworkStatusBackground}" />
                            <TextBlock
                                x:Name="WifiStatus2"
                                Margin="{x:Bind Mode=OneWay, Path=ViewModel.NetworkStatusMargin}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="{x:Bind Mode=OneWay, Path=ViewModel.ThemedIconBrush}"
                                Text="{x:Bind Mode=OneWay, Path=ViewModel.NetworkStatusCharacter}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</Page>
