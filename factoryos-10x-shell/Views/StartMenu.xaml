<Page
    x:Class="factoryos_10x_shell.Views.StartMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:factoryos_10x_shell.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="Windows11StartEntryStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.083" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="ItemContent" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ItemContent" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
                            <Border x:Name="Hover" Background="{ThemeResource Windows11ItemHoverFill}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressedPlate" Background="{ThemeResource Windows11ItemPressedFill}"
                                    CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter x:Name="ItemContent" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush
            x:Key="WhiteTintBrushStrong"
            Opacity="0.15"
            Color="Gray" />
        <SolidColorBrush
            x:Key="WhiteTintBrushNormal"
            Opacity="0.1"
            Color="Gray" />
    </Page.Resources>

    <Grid
        x:Name="StartSurface"
        MaxHeight="685"
        Background="Transparent"
        CornerRadius="4">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="SearchRow" Height="120" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="Windows10XStartPlate" Grid.RowSpan="2" CornerRadius="4"
                Background="{ThemeResource TaskbarAcrylicBrush}" IsHitTestVisible="False" />
        <Border x:Name="Windows11StartPlate" Grid.RowSpan="2" CornerRadius="12" BorderThickness="1"
                Background="{ThemeResource Windows11StartAcrylic}" IsHitTestVisible="False" Visibility="Collapsed" />
        <Grid Grid.Row="0">
            <Border
                x:Name="SearchPlate"
                Height="48"
                MaxWidth="640"
                Margin="40,0,40,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{ThemeResource WhiteTintBrushStrong}"
                CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7*" />
                        <RowDefinition Height="9*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Margin="17,16,0,0"
                        VerticalAlignment="Top"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Opacity="0.8"
                        Text="&#xE721;" />
                    <TextBox
                        x:Name="AppSearchBox"
                        GotFocus="AppSearchBox_GotFocus"
                        PointerPressed="AppSearchBox_PointerPressed"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Margin="10,8,10,0"
                        VerticalAlignment="Top"
                        PlaceholderText="Search the web or your devices"
                        TextChanged="AppSearchBox_TextChanged"
                        KeyDown="AppSearchBox_KeyDown"
                        Style="{ThemeResource TextBoxStyleBlack}" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="Windows10XContent" Grid.Row="1">
            <Border x:Name="Windows10XStartBody" Background="{ThemeResource WhiteTintBrushNormal}" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    MaxWidth="640"
                    Margin="40,25,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Top"
                            FontWeight="SemiBold"
                            x:Name="AppsHeading" Text="My apps" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="AppListShow" Width="85" Height="24" Padding="0" Background="{ThemeResource WhiteTintBrushStrong}" Command="{x:Bind ViewModel.AppsListToggleClickedCommand, Mode=OneWay}" Content="{x:Bind ViewModel.AppsListToggleContent, Mode=OneWay}" CornerRadius="10" FontSize="13" />
                    </StackPanel>
                </Grid>
            </Grid>
            <ScrollViewer Margin="0,51,0,0" HorizontalScrollMode="Disabled">
                <StackPanel>
                    <GridView
                        x:Name="AppListGrid"
                        Height="{x:Bind ViewModel.AppsListGridHeight, Mode=OneWay}"
                        Margin="5,20,5,4"
                        Padding="0"
                        HorizontalAlignment="Center"
                        ItemContainerStyle="{StaticResource AppsListGridItemStyle}"
                        ItemsSource="{x:Bind FilteredApps}"
                        ReorderMode="Enabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button
                                        x:Name="AppButton"
                                        Width="90"
                                        Height="90"
                                        Click="AppButton_Click"
                                        Style="{StaticResource AppIconBackgroundStyle}">
                                        <Button.ContextFlyout>
                                            <MenuFlyout Opened="ContextFlyout_Opened" Closed="ContextFlyout_Closed">
                                                <MenuFlyoutItem Click="PinToTaskbar_Click" Text="Pin to taskbar" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                    </Button>
                                    <StackPanel
                                        IsHitTestVisible="False"
                                        Width="90"
                                        Height="90"
                                        Padding="0"
                                        VerticalAlignment="Center">
                                        <Grid Width="48" Height="48" Margin="0,12,0,0" HorizontalAlignment="Center" IsHitTestVisible="False">
                                            <Image Width="48" Height="48" Source="{Binding IconSource}" />
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="38" Text="{Binding IconGlyph}" />
                                        </Grid>
                                        <TextBlock
                                            Margin="5,5,5,0"
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            IsHitTestVisible="False"
                                            MaxLines="1"
                                            Text="{Binding IconName}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <TextBlock x:Name="NoSearchResults" Visibility="Collapsed" Margin="40,24,40,24" HorizontalAlignment="Center" Text="No apps found." Opacity="0.7" />
                    <Grid x:Name="WebAppsSection" MaxWidth="640" Margin="40,0,40,0" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Web apps" />
                            <Button x:Name="InstallWebAppButton" Width="85" Height="24" Margin="0,0,8,0" Padding="0" Click="InstallWebAppButton_Click" Content="Install app" CornerRadius="10" FontSize="13" />

                            <GridView Margin="0,8,0,12" HorizontalAlignment="Left" ItemsSource="{x:Bind FilteredWebApps}">
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="90" Height="90" Click="WebAppButton_Click" Style="{StaticResource AppIconBackgroundStyle}">
                                            <Button.ContextFlyout>
                                            <MenuFlyout Opened="ContextFlyout_Opened" Closed="ContextFlyout_Closed">
                                                <MenuFlyoutItem Click="NewWebAppWindow_Click" Text="{Binding NewInstanceText}" />
                                                <MenuFlyoutItem Click="PinWebApp_Click" Text="Pin to taskbar" />
                                                    <MenuFlyoutItem Click="UninstallWebApp_Click" Text="Uninstall" />
                                                </MenuFlyout>
                                            </Button.ContextFlyout>
                                            <StackPanel VerticalAlignment="Center">
                                                <Grid Width="32" Height="32" HorizontalAlignment="Center">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="26" Opacity="{Binding FallbackGlyphOpacity}" Text="&#xE774;" />
                                                    <Image Width="32" Height="32" Source="{Binding IconUri}" Stretch="Uniform" />
                                                </Grid>
                                                <TextBlock Margin="5,5,5,0" HorizontalAlignment="Center" FontSize="11" MaxLines="1" Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Grid>
                    <Border
                        Height="1"
                        Margin="0,15,0,0"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource WhiteTintBrushStrong}" />
                    <Grid
                        MaxWidth="640"
                        Margin="40,0,40,0"
                        HorizontalAlignment="Stretch">
                        <TextBlock
                            x:Name="LegacyFooterSpacer"
                            Margin="0,25,0,120"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Opacity="0"
                            Text="Recent" />

                        <Button
                            x:Name="PowerButton"
                            Width="75"
                            Height="50"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Click="PowerButton_click"
                            Style="{StaticResource TaskbarButtonStyle}">
                            <Button.Content>
                                <TextBlock
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="24"
                                    Text="&#xE7E8;" />
                            </Button.Content>
                        </Button>

                        <Button
                            x:Name="SettingsButton"
                            Width="75"
                            Height="50"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Click="SettingsButton_click"
                            Style="{StaticResource TaskbarButtonStyle}">
                            <Button.Content>
                                <TextBlock
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="24"
                                    Text="&#xE713;" />
                            </Button.Content>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="Windows11StartBody" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="30,6,30,8">
                <TextBlock x:Name="Windows11StartHeading" Text="Pinned" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="Windows11AppsToggle" Content="All apps  ›" Click="Windows11AppsToggle_Click"
                        HorizontalAlignment="Right" FontSize="12" CornerRadius="5" />
            </Grid>
            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,0,24,16">
                    <GridView x:Name="Windows11Pins" ItemsSource="{x:Bind Windows11PinnedApps}"
                              SelectionMode="None" ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center">
                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" /></ItemsPanelTemplate></GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Button Width="86" Height="76" Padding="0" CornerRadius="6" Style="{StaticResource Windows11StartEntryStyle}"
                                        Click="Windows11App_Click" RightTapped="Windows11App_RightTapped" ToolTipService.ToolTip="{Binding IconName}">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <Grid Width="32" Height="32" HorizontalAlignment="Center">
                                            <FontIcon Glyph="{Binding IconGlyph}" FontSize="25" />
                                            <Image Source="{Binding IconSource}" Stretch="Uniform" />
                                        </Grid>
                                        <TextBlock Width="72" Text="{Binding IconName}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <StackPanel x:Name="Windows11Recommended" Margin="6,20,6,0" Spacing="8">
                        <TextBlock Text="Recommended" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="Windows11RecentHint" Text="Apps you open will appear here." Opacity="0.65" />
                        <GridView ItemsSource="{x:Bind Windows11RecentApps}" SelectionMode="None"
                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" /></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Windows11StartEntryStyle}" CornerRadius="6" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left" Click="Windows11App_Click">
                                        <StackPanel Width="218" Orientation="Horizontal" Spacing="10">
                                            <Image Source="{Binding IconSource}" Width="24" Height="24" />
                                            <TextBlock MaxWidth="170" Text="{Binding IconName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                    <ItemsControl x:Name="Windows11AllApps" ItemsSource="{x:Bind Windows11ListedApps}" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button MinHeight="42" Style="{StaticResource Windows11StartEntryStyle}" CornerRadius="6"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Click="Windows11App_Click" RightTapped="Windows11App_RightTapped">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Grid Width="24" Height="24">
                                            <FontIcon Glyph="{Binding IconGlyph}" FontSize="19" />
                                            <Image Source="{Binding IconSource}" Stretch="Uniform" />
                                        </Grid>
                                        <TextBlock Text="{Binding IconName}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="Windows11NoResults" Text="No apps found." Margin="12" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="Windows11BottomBar" Grid.Row="2" CornerRadius="0,0,12,12" Padding="26,5">
                <Grid>
                    <Button Background="Transparent" BorderThickness="0" CornerRadius="6" Click="SettingsButton_click"
                            ToolTipService.ToolTip="Settings" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="Contact" />
                            <TextBlock Text="Desktop Mode" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                        <Button Background="Transparent" BorderThickness="0" CornerRadius="6" Click="InstallWebAppButton_Click" ToolTipService.ToolTip="Install app">
                            <SymbolIcon Symbol="Add" />
                        </Button>
                        <Button Background="Transparent" BorderThickness="0" CornerRadius="6" Click="PowerButton_click" ToolTipService.ToolTip="Power">
                            <FontIcon Glyph="&#xE7E8;" FontSize="17" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
