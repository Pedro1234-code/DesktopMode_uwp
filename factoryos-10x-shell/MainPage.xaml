<Page
    x:Class="factoryos_10x_shell.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:factoryos_10x_shell"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >

    <Grid x:Name="ContentRoot">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="DesktopScaleTransform" />
        </Grid.RenderTransform>
        <Frame x:Name="DesktopFrame" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        </Frame>
        <Canvas x:Name="MouseCursorLayer"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Canvas.ZIndex="10000">
            <Image x:Name="MouseCursor"
                   Source="ms-appx:///Assets/Cursor/aero_arrow_xl_fix.png"
                   Stretch="Uniform"
                   Visibility="Collapsed">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="MouseCursorTransform" />
                </Image.RenderTransform>
            </Image>
            <Viewbox x:Name="ResizeCursor"
                     Width="24"
                     Height="24"
                     Visibility="Collapsed">
                <Viewbox.RenderTransform>
                    <TranslateTransform x:Name="ResizeCursorTransform" />
                </Viewbox.RenderTransform>
                <Canvas Width="24" Height="24">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="ResizeCursorRotation" CenterX="12" CenterY="12" />
                    </Canvas.RenderTransform>
                    <Path Data="M3,3 L21,21 M3,9 L3,3 L9,3 M15,21 L21,21 L21,15"
                          Stroke="Black" StrokeThickness="3.5" StrokeLineJoin="Round" />
                    <Path Data="M3,3 L21,21 M3,9 L3,3 L9,3 M15,21 L21,21 L21,15"
                          Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" />
                </Canvas>
            </Viewbox>
        </Canvas>
    </Grid>
</Page>
