<Page
    x:Class="factoryos_10x_shell.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:factoryos_10x_shell"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >

    <Grid x:Name="ContentRoot">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="DesktopScaleTransform" />
        </Grid.RenderTransform>
        <Frame x:Name="DesktopFrame" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        </Frame>
        <Canvas x:Name="MouseCursorLayer"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Canvas.ZIndex="10000">
            <Image x:Name="MouseCursor"
                   Source="ms-appx:///Assets/Cursor/aero_arrow_xl_fix.png"
                   Stretch="Uniform"
                   Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Page>
