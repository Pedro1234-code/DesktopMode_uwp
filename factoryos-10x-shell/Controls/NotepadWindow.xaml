<UserControl
    x:Class="factoryos_10x_shell.Controls.NotepadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Width="820"
    Height="560">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush x:Key="NotepadBackdropBrush" BackgroundSource="Backdrop" FallbackColor="#FF202020" TintColor="#FF202020" TintLuminosityOpacity="0.90" TintOpacity="0.16" />
                    <SolidColorBrush x:Key="NotepadEditorBrush" Color="#E6202020" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="NotepadBackdropBrush" BackgroundSource="Backdrop" FallbackColor="#FFF5F5F5" TintColor="#FFF5F5F5" TintLuminosityOpacity="0.94" TintOpacity="0.18" />
                    <SolidColorBrush x:Key="NotepadEditorBrush" Color="#E6FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="NotepadBackdropBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NotepadEditorBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="NotepadMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="NotepadCommandButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource NotepadBackdropBrush}"
        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid PointerEntered="Root_PointerEntered" PointerExited="Root_PointerExited" PointerPressed="Root_PointerPressed">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="TitleBar"
                Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="Transparent" DoubleTapped="TitleBar_DoubleTapped" PointerMoved="TitleBar_PointerMoved" PointerPressed="TitleBar_PointerPressed" PointerReleased="TitleBar_PointerReleased" ToolTipService.ToolTip="Notepad">
                    <Image Width="18" Height="18" HorizontalAlignment="Center" Source="ms-appx:///Assets/Notepad/notepad.png" Stretch="Uniform" />
                </Border>
                <muxc:TabView
                    x:Name="DocumentTabs"
                    Grid.Column="1"
                    Height="40"
                    Background="Transparent"
                    CanReorderTabs="True"
                    IsAddTabButtonVisible="True"
                    AddTabButtonClick="DocumentTabs_AddTabButtonClick"
                    SelectionChanged="DocumentTabs_SelectionChanged"
                    TabCloseRequested="DocumentTabs_TabCloseRequested">
                    <muxc:TabView.TabStripFooter>
                        <Border
                            MinWidth="72"
                            Height="40"
                            Background="Transparent"
                            DoubleTapped="TitleBar_DoubleTapped"
                            PointerMoved="TitleBar_PointerMoved"
                            PointerPressed="TitleBar_PointerPressed"
                            PointerReleased="TitleBar_PointerReleased" />
                    </muxc:TabView.TabStripFooter>
                </muxc:TabView>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource ShellCaptionButtonStyle}" Click="Minimize_Click" ToolTipService.ToolTip="Minimize"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE921;" /></Button>
                    <Button Style="{StaticResource ShellCaptionButtonStyle}" Click="Maximize_Click" ToolTipService.ToolTip="Maximize"><TextBlock x:Name="MaximizeGlyph" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE922;" /></Button>
                    <Button Style="{StaticResource ShellCloseButtonStyle}" Click="Close_Click" ToolTipService.ToolTip="Close"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE8BB;" /></Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Padding="7,3" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button Content="File" Style="{StaticResource NotepadMenuButtonStyle}">
                        <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedLeft"><MenuFlyoutItem Text="New tab" Click="New_Click" /><MenuFlyoutItem Text="Open..." Click="Open_Click" /><MenuFlyoutSeparator /><MenuFlyoutItem Text="Save" Click="Save_Click" /><MenuFlyoutItem Text="Save as..." Click="SaveAs_Click" /><MenuFlyoutSeparator /><MenuFlyoutItem Text="Close tab" Click="CloseTab_Click" /></MenuFlyout></Button.Flyout>
                    </Button>
                    <Button Content="Edit" Style="{StaticResource NotepadMenuButtonStyle}">
                        <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedLeft"><MenuFlyoutItem Text="Undo" Click="Undo_Click" /><MenuFlyoutItem Text="Redo" Click="Redo_Click" /><MenuFlyoutSeparator /><MenuFlyoutItem Text="Cut" Click="Cut_Click" /><MenuFlyoutItem Text="Copy" Click="Copy_Click" /><MenuFlyoutItem Text="Paste" Click="Paste_Click" /><MenuFlyoutSeparator /><MenuFlyoutItem Text="Select all" Click="SelectAll_Click" /></MenuFlyout></Button.Flyout>
                    </Button>
                    <Button Content="View" Style="{StaticResource NotepadMenuButtonStyle}">
                        <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedLeft"><ToggleMenuFlyoutItem x:Name="WordWrapMenuItem" Text="Word wrap" Click="WordWrap_Click" /><ToggleMenuFlyoutItem x:Name="StatusBarMenuItem" Text="Status bar" IsChecked="True" Click="StatusBar_Click" /></MenuFlyout></Button.Flyout>
                    </Button>
                    <Rectangle Width="1" Height="20" Margin="7,0" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                    <Button Style="{StaticResource NotepadCommandButtonStyle}" Click="Save_Click" ToolTipService.ToolTip="Save (Ctrl+S)"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE74E;" /></Button>
                    <Button Style="{StaticResource NotepadCommandButtonStyle}" Click="Undo_Click" ToolTipService.ToolTip="Undo (Ctrl+Z)"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE7A7;" /></Button>
                    <Button Style="{StaticResource NotepadCommandButtonStyle}" Click="Redo_Click" ToolTipService.ToolTip="Redo (Ctrl+Y)"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE7A6;" /></Button>
                </StackPanel>
            </Grid>

            <TextBox
                x:Name="Editor"
                Grid.Row="2"
                Padding="14,10"
                AcceptsReturn="True"
                Background="{ThemeResource NotepadEditorBrush}"
                BorderThickness="0"
                FontFamily="Consolas"
                FontSize="15"
                IsSpellCheckEnabled="False"
                GotFocus="Editor_GotFocus"
                KeyDown="Editor_KeyDown"
                SelectionChanged="Editor_SelectionChanged"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextChanged="Editor_TextChanged"
                TextWrapping="NoWrap" />

            <Border x:Name="StatusBar" Grid.Row="3" Height="27" Padding="12,0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" Opacity="0.72" Text="Ln 1, Col 1" />
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="22"><TextBlock FontSize="11" Opacity="0.72" Text="100%" /><TextBlock FontSize="11" Opacity="0.72" Text="Windows (CRLF)" /><TextBlock FontSize="11" Opacity="0.72" Text="UTF-8" /></StackPanel>
                </Grid>
            </Border>

            <Border Grid.RowSpan="4" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Tag="TopLeft" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased" />
            <Border Grid.RowSpan="4" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Tag="TopRight" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased" />
            <Border Grid.RowSpan="4" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Tag="BottomLeft" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased" />
            <Border x:Name="ResizeGrip" Grid.RowSpan="4" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Tag="BottomRight" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="10" Opacity="0.5" Text="&#xE76C;" /></Border>
        </Grid>
    </Border>
</UserControl>
