<UserControl
    x:Class="factoryos_10x_shell.Controls.NotepadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="760" Height="520">
    <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="#FF5A5A5A" BorderThickness="1" CornerRadius="4">
        <Grid PointerPressed="Root_PointerPressed">
            <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="24" /></Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Background="#FF303030" PointerPressed="TitleBar_PointerPressed" PointerMoved="TitleBar_PointerMoved" PointerReleased="TitleBar_PointerReleased">
                <TextBlock x:Name="TitleText" Margin="12,0,150,0" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="Untitled - Notepad" TextTrimming="CharacterEllipsis" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ShellCaptionButtonStyle}" Click="Minimize_Click"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White" Text="&#xE921;" /></Button>
                    <Button Style="{StaticResource ShellCaptionButtonStyle}" Click="Maximize_Click"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White" Text="&#xE922;" /></Button>
                    <Button Style="{StaticResource ShellCloseButtonStyle}" Click="Close_Click"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White" Text="&#xE8BB;" /></Button>
                </StackPanel>
            </Grid>
            <CommandBar Grid.Row="1" DefaultLabelPosition="Right" IsOpen="False" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <AppBarButton Icon="Page2" Label="New" Click="New_Click" />
                <AppBarButton Icon="OpenFile" Label="Open" Click="Open_Click" />
                <AppBarButton Icon="Save" Label="Save" Click="Save_Click" />
                <AppBarButton Icon="SaveLocal" Label="Save as" Click="SaveAs_Click" />
                <AppBarSeparator />
                <AppBarButton Icon="Undo" Label="Undo" Click="Undo_Click" />
                <AppBarButton Icon="Redo" Label="Redo" Click="Redo_Click" />
            </CommandBar>
            <TextBox x:Name="Editor" Grid.Row="2" Margin="16,8" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="15" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextChanged="Editor_TextChanged" KeyDown="Editor_KeyDown" />
            <Grid Grid.Row="3" Margin="16,0"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="11" Text="Ln 1, Col 1" /></Grid>
            <Border Grid.RowSpan="4" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Tag="TopLeft" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased" />
            <Border Grid.RowSpan="4" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Tag="TopRight" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased" />
            <Border Grid.RowSpan="4" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Tag="BottomLeft" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased" />
            <Border x:Name="ResizeGrip" Grid.RowSpan="4" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Tag="BottomRight" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE76C;" /></Border>
        </Grid>
    </Border>
</UserControl>
