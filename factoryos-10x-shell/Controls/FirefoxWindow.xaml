<UserControl
    x:Class="factoryos_10x_shell.Controls.FirefoxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1080"
    Height="650">
    <Border x:Name="WindowBorder" Background="#FF1C1B22" BorderBrush="#FF5A5A5A" BorderThickness="1" CornerRadius="4">
        <Grid PointerEntered="Root_PointerEntered" PointerExited="Root_PointerExited" PointerPressed="Root_PointerPressed">
            <Grid x:Name="BrowserSurface" Background="#FF1C1B22" SizeChanged="BrowserSurface_SizeChanged" />
            <Border x:Name="UploadDropTarget" Background="Transparent" AllowDrop="True" IsHitTestVisible="False"
                    DragEnter="BrowserSurface_DragEnter" DragOver="BrowserSurface_DragOver"
                    DragLeave="BrowserSurface_DragLeave" Drop="BrowserSurface_Drop" />
            <Border x:Name="ResizeEdgeLeft" Width="5" HorizontalAlignment="Left" Margin="0,18,0,18" Background="Transparent" Tag="Left" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased" PointerCaptureLost="ResizeGrip_PointerReleased" PointerCanceled="ResizeGrip_PointerReleased" />
            <Border x:Name="ResizeEdgeTop" Height="5" VerticalAlignment="Top" Margin="18,0,18,0" Background="Transparent" Tag="Top" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased" PointerCaptureLost="ResizeGrip_PointerReleased" PointerCanceled="ResizeGrip_PointerReleased" />
            <Border x:Name="ResizeEdgeRight" Width="5" HorizontalAlignment="Right" Margin="0,18,0,18" Background="Transparent" Tag="Right" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased" PointerCaptureLost="ResizeGrip_PointerReleased" PointerCanceled="ResizeGrip_PointerReleased" />
            <Border x:Name="ResizeEdgeBottom" Height="5" VerticalAlignment="Bottom" Margin="18,0,18,0" Background="Transparent" Tag="Bottom" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased" PointerCaptureLost="ResizeGrip_PointerReleased" PointerCanceled="ResizeGrip_PointerReleased" />
            <Border x:Name="ResizeGripTopLeft" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Tag="TopLeft" PointerMoved="ResizeGrip_PointerMoved" PointerPressed="ResizeGrip_PointerPressed" PointerReleased="ResizeGrip_PointerReleased" PointerCaptureLost="ResizeGrip_PointerReleased" PointerCanceled="ResizeGrip_PointerReleased" />
            <Border x:Name="ResizeGripTopRight" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Tag="TopRight" PointerMoved="ResizeGrip_PointerMoved" PointerPressed="ResizeGrip_PointerPressed" PointerReleased="ResizeGrip_PointerReleased" PointerCaptureLost="ResizeGrip_PointerReleased" PointerCanceled="ResizeGrip_PointerReleased" />
            <Border x:Name="ResizeGripBottomLeft" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Tag="BottomLeft" PointerMoved="ResizeGrip_PointerMoved" PointerPressed="ResizeGrip_PointerPressed" PointerReleased="ResizeGrip_PointerReleased" PointerCaptureLost="ResizeGrip_PointerReleased" PointerCanceled="ResizeGrip_PointerReleased" />
            <Border x:Name="ResizeGrip"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Tag="BottomRight"
                    PointerMoved="ResizeGrip_PointerMoved"
                    PointerPressed="ResizeGrip_PointerPressed"
                    PointerReleased="ResizeGrip_PointerReleased" PointerCaptureLost="ResizeGrip_PointerReleased" PointerCanceled="ResizeGrip_PointerReleased">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" Text="&#xE76C;" />
            </Border>
        </Grid>
    </Border>
</UserControl>
