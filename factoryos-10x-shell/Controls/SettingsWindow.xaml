            <StackPanel x:Name="AboutPanel" Margin="0,25,0,0" Visibility="Collapsed"><TextBlock FontSize="20" FontWeight="SemiBold" Text="Device specifications"/><Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="Device name"/><TextBlock x:Name="DeviceNameValue" Grid.Row="0" Grid.Column="1"/><TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Text="Manufacturer"/><TextBlock x:Name="ManufacturerValue" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Text="Model"/><TextBlock x:Name="ModelValue" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"/><TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Text="System type"/><TextBlock x:Name="SystemTypeValue" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"/></Grid><TextBlock Margin="0,30,0,8" FontSize="20" FontWeight="SemiBold" Text="Windows specifications"/><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="Edition"/><TextBlock x:Name="EditionValue" Grid.Row="0" Grid.Column="1"/><TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Text="OS build"/><TextBlock x:Name="BuildValue" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Text="Experience"/><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="Windows 10X experience"/></Grid></StackPanel>
            <StackPanel x:Name="DebugPanel" Margin="0,25,0,0" Visibility="Collapsed"><TextBlock FontSize="20" FontWeight="SemiBold" Text="Package monitoring"/><ToggleSwitch x:Name="DisableLivePackageTrackingToggle" Margin="0,18,0,0" Header="Disable real-time package change tracking" Toggled="DisableLivePackageTrackingToggle_Toggled"/><TextBlock Margin="0,12,0,0" MaxWidth="560" HorizontalAlignment="Left" TextWrapping="Wrap" Opacity=".65" Text="Installed apps will still be loaded when Desktop Mode starts, but the Start menu will not refresh automatically after packages are installed, updated, or removed."/></StackPanel>
            <StackPanel x:Name="WindowsUpdatePanel" Margin="0,25,0,0" Visibility="Collapsed"><TextBlock FontSize="20" FontWeight="SemiBold" Text="Windows Update"/><TextBlock Margin="0,14,0,0" Text="Keep your device up to date with the latest features and security improvements."/><TextBlock Margin="0,22,0,4" FontWeight="SemiBold" Text="Current version"/><TextBlock x:Name="CurrentVersionText" Opacity=".72"/><Button x:Name="CheckForUpdatesButton" Margin="0,24,0,0" HorizontalAlignment="Left" Click="CheckForUpdates_Click"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;"/><TextBlock Text="Check for updates"/></StackPanel></Button><TextBlock x:Name="UpdateStatusText" Margin="0,14,0,0" Opacity=".7" Text="Ready to check for updates."/><ToggleSwitch x:Name="AutomaticUpdateCheckToggle" Margin="0,28,0,0" Header="Enable automatic update check on startup" Toggled="AutomaticUpdateCheckToggle_Toggled"/></StackPanel>
            <StackPanel x:Name="ForDevelopersPanel" Margin="0,25,0,0" Visibility="Collapsed">
              <TextBlock FontSize="20" FontWeight="SemiBold" Text="Win32 app support (beta)"/>
              <TextBlock Margin="0,8,0,0" FontSize="13" Opacity=".7" Text="Allow to execute legacy Win32 applications"/>
              <ToggleSwitch x:Name="Win32SupportToggle" Margin="0,18,0,0" HorizontalAlignment="Left" Toggled="Win32SupportToggle_Toggled"/>
            </StackPanel>
          </StackPanel></ScrollViewer></SplitView></Grid>
        </Grid>
        <Border Grid.RowSpan="2" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Tag="TopLeft" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased"/>
        <Border Grid.RowSpan="2" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Tag="TopRight" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased"/>
        <Border Grid.RowSpan="2" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Tag="BottomLeft" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased"/>
        <Border x:Name="ResizeGrip" Grid.RowSpan="2" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Tag="BottomRight" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE76C;"/></Border>
      </Grid>
  </Border>
</UserControl>
