<UserControl x:Class="factoryos_10x_shell.Controls.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="1040" Height="650">
  <UserControl.Resources>
    <Style x:Key="CaptionButton" TargetType="Button"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="B" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#24FFFFFF"/></ObjectAnimationUsingKeyFrames></Storyboard></VisualState><VisualState x:Name="Pressed"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="B" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#3DFFFFFF"/></ObjectAnimationUsingKeyFrames></Storyboard></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><Border x:Name="B" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="B" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#E81123"/></ObjectAnimationUsingKeyFrames></Storyboard></VisualState><VisualState x:Name="Pressed"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="B" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#C50F1F"/></ObjectAnimationUsingKeyFrames></Storyboard></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><Border x:Name="B" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SettingsTile" TargetType="Button"><Setter Property="Width" Value="250"/><Setter Property="Height" Value="90"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <AcrylicBrush x:Key="SettingsListAcrylic" BackgroundSource="HostBackdrop" FallbackColor="#D94D4D4D" TintColor="#FF454545" TintOpacity="0.42" TintLuminosityOpacity="0.64"/>
    <AcrylicBrush x:Key="SettingsContentAcrylic" BackgroundSource="HostBackdrop" FallbackColor="#F5202020" TintColor="#FF1C1C1C" TintOpacity="0.18" TintLuminosityOpacity="0.86"/>
    <Style x:Key="SettingsNavIcon" TargetType="TextBlock"><Setter Property="Width" Value="20"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="SettingsNavItem" TargetType="ListViewItem"><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="16,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="ItemRoot" Background="{TemplateBinding Background}" BorderThickness="0"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#18FFFFFF"/></ObjectAnimationUsingKeyFrames></Storyboard></VisualState><VisualState x:Name="Pressed"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#24FFFFFF"/></ObjectAnimationUsingKeyFrames></Storyboard></VisualState></VisualStateGroup><VisualStateGroup x:Name="SelectionStates"><VisualState x:Name="Unselected"/><VisualState x:Name="Selected"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#36FFFFFF"/></ObjectAnimationUsingKeyFrames></Storyboard></VisualState><VisualState x:Name="SelectedUnfocused"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#28FFFFFF"/></ObjectAnimationUsingKeyFrames></Storyboard></VisualState><VisualState x:Name="SelectedPointerOver"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#45FFFFFF"/></ObjectAnimationUsingKeyFrames></Storyboard></VisualState><VisualState x:Name="SelectedPressed"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#52FFFFFF"/></ObjectAnimationUsingKeyFrames></Storyboard></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  </UserControl.Resources>
  <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="#FF5A5A5A" BorderThickness="1" CornerRadius="4">
    <Grid PointerPressed="Root_PointerPressed"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Background="#FF303030" PointerPressed="TitleBar_PointerPressed" PointerMoved="TitleBar_PointerMoved" PointerReleased="TitleBar_PointerReleased">
        <TextBlock x:Name="TitleText" Margin="12,0,150,0" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="Settings"/>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Style="{StaticResource CaptionButton}" Click="Minimize_Click"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White" Text="&#xE921;"/></Button><Button Style="{StaticResource CaptionButton}" Click="Maximize_Click"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White" Text="&#xE922;"/></Button><Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White" Text="&#xE8BB;"/></Button></StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid x:Name="HomePage"><ScrollViewer><StackPanel Margin="52,45"><Grid Width="1000" HorizontalAlignment="Left"><TextBlock FontSize="32" FontWeight="SemiBold" Text="Settings"/><TextBox Width="270" HorizontalAlignment="Right" PlaceholderText="Find a setting" IsReadOnly="True" IsHitTestVisible="False" IsTabStop="False"/></Grid><Grid Margin="0,46,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsTile}" Click="System_Click"><StackPanel><TextBlock FontSize="27" FontFamily="Segoe MDL2 Assets" Foreground="#FF3D7FD5" Text="&#xE770;"/><TextBlock FontWeight="SemiBold" Text="System"/><TextBlock Opacity=".65" FontSize="12" Text="Display, sounds, notifications, battery"/></StackPanel></Button>
          <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsTile}" IsEnabled="False"><StackPanel><TextBlock FontSize="27" FontFamily="Segoe MDL2 Assets" Text="&#xE772;"/><TextBlock FontWeight="SemiBold" Text="Devices"/><TextBlock Opacity=".65" FontSize="12" Text="Bluetooth, printers, mouse"/></StackPanel></Button>
          <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource SettingsTile}" IsEnabled="False"><StackPanel><TextBlock FontSize="27" FontFamily="Segoe MDL2 Assets" Text="&#xE701;"/><TextBlock FontWeight="SemiBold" Text="Network &amp; Internet"/><TextBlock Opacity=".65" FontSize="12" Text="Wi-Fi, airplane mode, VPN"/></StackPanel></Button>
          <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsTile}" Click="Personalization_Click"><StackPanel><TextBlock FontSize="27" FontFamily="Segoe MDL2 Assets" Foreground="#FF3D7FD5" Text="&#xE790;"/><TextBlock FontWeight="SemiBold" Text="Personalization"/><TextBlock Opacity=".65" FontSize="12" Text="Background, colors, taskbar"/></StackPanel></Button>
          <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsTile}" IsEnabled="False"><StackPanel><TextBlock FontSize="27" FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;"/><TextBlock FontWeight="SemiBold" Text="Apps"/><TextBlock Opacity=".65" FontSize="12" Text="Uninstall, apps for websites, offline maps"/></StackPanel></Button>
          <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsTile}" IsEnabled="False"><StackPanel><TextBlock FontSize="27" FontFamily="Segoe MDL2 Assets" Text="&#xE77B;"/><TextBlock FontWeight="SemiBold" Text="Accounts"/><TextBlock Opacity=".65" FontSize="12" Text="Your accounts, email, sync"/></StackPanel></Button>
          <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingsTile}" IsEnabled="False"><TextBlock Text="Time &amp; Language"/></Button><Button Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingsTile}" IsEnabled="False"><TextBlock Text="Ease of Access"/></Button><Button Grid.Row="2" Grid.Column="2" Style="{StaticResource SettingsTile}" IsEnabled="False"><TextBlock Text="Search"/></Button>
          <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource SettingsTile}" IsEnabled="False"><TextBlock Text="Privacy"/></Button><Button Grid.Row="3" Grid.Column="1" Style="{StaticResource SettingsTile}" Click="UpdateSecurity_Click"><StackPanel><TextBlock FontSize="27" FontFamily="Segoe MDL2 Assets" Foreground="#FF3D7FD5" Text="&#xE777;"/><TextBlock FontWeight="SemiBold" Text="Update &amp; Security"/><TextBlock Opacity=".65" FontSize="12" Text="Windows Update, recovery, backup"/></StackPanel></Button>
        </Grid></StackPanel></ScrollViewer></Grid>
        <Grid x:Name="DetailPage" Visibility="Collapsed"><SplitView x:Name="SettingsSplitView" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="250" CompactPaneLength="48" PanePlacement="Left" PaneBackground="#FF4B4B4B">
          <SplitView.Pane>
            <StackPanel>
              <ListView x:Name="HomeNavigation" Background="{StaticResource SettingsListAcrylic}" SelectionMode="Single" SelectionChanged="SettingsNavigation_SelectionChanged" ItemContainerStyle="{StaticResource SettingsNavItem}">
                <ListViewItem Tag="Home"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Style="{StaticResource SettingsNavIcon}" Text="&#xE80F;"/><TextBlock Text="Home" VerticalAlignment="Center"/></StackPanel></ListViewItem>
              </ListView>
              <TextBox Margin="14,8" PlaceholderText="Find a setting" IsReadOnly="True" IsHitTestVisible="False" IsTabStop="False"/>
              <TextBlock x:Name="SectionTitle" Margin="16,12" FontWeight="SemiBold"/>
              <ListView x:Name="PersonalizationNavigation" Background="{StaticResource SettingsListAcrylic}" SelectionMode="Single" SelectionChanged="SettingsNavigation_SelectionChanged" ItemContainerStyle="{StaticResource SettingsNavItem}">
                <ListViewItem Tag="Background"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Style="{StaticResource SettingsNavIcon}" Text="&#xE91B;"/><TextBlock Text="Background" VerticalAlignment="Center"/></StackPanel></ListViewItem>
                <ListViewItem Tag="Colors"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Style="{StaticResource SettingsNavIcon}" Text="&#xE790;"/><TextBlock Text="Colors" VerticalAlignment="Center"/></StackPanel></ListViewItem>
                <ListViewItem Tag="Launcher"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Style="{StaticResource SettingsNavIcon}" Text="&#xE71D;"/><TextBlock Text="Launcher" VerticalAlignment="Center"/></StackPanel></ListViewItem>
                <ListViewItem Tag="Taskbar"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Style="{StaticResource SettingsNavIcon}" Text="&#xE7F4;"/><TextBlock Text="Taskbar" VerticalAlignment="Center"/></StackPanel></ListViewItem>
              </ListView>
              <ListView x:Name="SystemNavigation" Background="{StaticResource SettingsListAcrylic}" Visibility="Collapsed" SelectionMode="Single" SelectionChanged="SettingsNavigation_SelectionChanged" ItemContainerStyle="{StaticResource SettingsNavItem}">
                <ListViewItem Tag="About"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Style="{StaticResource SettingsNavIcon}" Text="&#xE946;"/><TextBlock Text="About" VerticalAlignment="Center"/></StackPanel></ListViewItem>
              </ListView>
              <ListView x:Name="UpdateSecurityNavigation" Background="{StaticResource SettingsListAcrylic}" Visibility="Collapsed" SelectionMode="Single" SelectionChanged="SettingsNavigation_SelectionChanged" ItemContainerStyle="{StaticResource SettingsNavItem}">
                <ListViewItem Tag="Windows Update"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Style="{StaticResource SettingsNavIcon}" Text="&#xE777;"/><TextBlock Text="Windows Update" VerticalAlignment="Center"/></StackPanel></ListViewItem>
              </ListView>
            </StackPanel>
          </SplitView.Pane>
          <ScrollViewer Background="{StaticResource SettingsContentAcrylic}"><StackPanel x:Name="DetailContent" Margin="42,32"><TextBlock x:Name="DetailTitle" FontSize="29" FontWeight="SemiBold" Text="Background"/><Grid x:Name="BackgroundPanel" Margin="0,25,0,0"><StackPanel><Border Width="400" Height="220" HorizontalAlignment="Left" Background="#FF0B4F96" CornerRadius="4"><Image x:Name="WallpaperPreview" Source="ms-appx:///10x.png" Stretch="UniformToFill"/></Border><TextBlock Margin="0,22,0,8" FontWeight="SemiBold" Text="Static wallpaper"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Width="80" Height="58" Tag="ms-appx:///Windows10x-js-main/Walls/wall1.jpg" Click="Wallpaper_Click"><Image Source="ms-appx:///Windows10x-js-main/Walls/wall1.jpg" Stretch="UniformToFill"/></Button><Button Width="80" Height="58" Tag="ms-appx:///Windows10x-js-main/Walls/wall2.jpg" Click="Wallpaper_Click"><Image Source="ms-appx:///Windows10x-js-main/Walls/wall2.jpg" Stretch="UniformToFill"/></Button><Button Width="80" Height="58" Tag="ms-appx:///Windows10x-js-main/Walls/wall3.jpg" Click="Wallpaper_Click"><Image Source="ms-appx:///Windows10x-js-main/Walls/wall3.jpg" Stretch="UniformToFill"/></Button><Button Width="80" Height="58" Tag="ms-appx:///Windows10x-js-main/Walls/wall4.jpg" Click="Wallpaper_Click"><Image Source="ms-appx:///Windows10x-js-main/Walls/wall4.jpg" Stretch="UniformToFill"/></Button><Button Width="80" Height="58" Tag="ms-appx:///Windows10x-js-main/Walls/wall5.jpg" Click="Wallpaper_Click"><Image Source="ms-appx:///Windows10x-js-main/Walls/wall5.jpg" Stretch="UniformToFill"/></Button></StackPanel><Button Margin="0,22,0,0" HorizontalAlignment="Left" Content="Browse for a picture" Click="BrowseWallpaper_Click"/></StackPanel></Grid>
            <StackPanel x:Name="ColorsPanel" Margin="0,25,0,0" Visibility="Collapsed"><TextBlock FontSize="17" FontWeight="SemiBold" Text="Choose your accent color"/><StackPanel Margin="0,16" Orientation="Horizontal" Spacing="10"><Button Tag="#FF3D7FD5" Background="#FF3D7FD5" Width="42" Height="42" Click="Accent_Click"/><Button Tag="#FF30AEAA" Background="#FF30AEAA" Width="42" Height="42" Click="Accent_Click"/><Button Tag="#FFB32B1D" Background="#FFB32B1D" Width="42" Height="42" Click="Accent_Click"/><Button Tag="#FF0283E5" Background="#FF0283E5" Width="42" Height="42" Click="Accent_Click"/><Button Tag="#FFC67AB8" Background="#FFC67AB8" Width="42" Height="42" Click="Accent_Click"/></StackPanel></StackPanel>
            <StackPanel x:Name="LauncherPanel" Margin="0,25,0,0" Visibility="Collapsed"><TextBlock FontSize="17" FontWeight="SemiBold" Text="Launcher size"/><StackPanel Margin="0,16" Orientation="Horizontal" Spacing="10"><Button Tag="Normal" Content="Normal" Click="LauncherSize_Click"/><Button Tag="Wide" Content="Wide" Click="LauncherSize_Click"/></StackPanel><TextBlock Margin="0,20" Opacity=".65" Text="The Launcher will automatically shrink if your screen is too small."/></StackPanel>
            <StackPanel x:Name="TaskbarPanel" Margin="0,25,0,0" Visibility="Collapsed"><TextBlock FontSize="17" FontWeight="SemiBold" Text="Taskbar"/><ToggleSwitch x:Name="SearchToggle" Header="Show Search button" Toggled="SearchToggle_Toggled"/><ToggleSwitch x:Name="CopilotToggle" Header="Show Copilot button" Toggled="CopilotToggle_Toggled"/><ToggleSwitch x:Name="BackgroundToggle" Header="Show background button" Toggled="BackgroundToggle_Toggled"/></StackPanel>
            <StackPanel x:Name="AboutPanel" Margin="0,25,0,0" Visibility="Collapsed"><TextBlock FontSize="20" FontWeight="SemiBold" Text="Device specifications"/><Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="Device name"/><TextBlock x:Name="DeviceNameValue" Grid.Row="0" Grid.Column="1"/><TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Text="Manufacturer"/><TextBlock x:Name="ManufacturerValue" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Text="Model"/><TextBlock x:Name="ModelValue" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"/><TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Text="System type"/><TextBlock x:Name="SystemTypeValue" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"/></Grid><TextBlock Margin="0,30,0,8" FontSize="20" FontWeight="SemiBold" Text="Windows specifications"/><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="Edition"/><TextBlock x:Name="EditionValue" Grid.Row="0" Grid.Column="1"/><TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Text="OS build"/><TextBlock x:Name="BuildValue" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Text="Experience"/><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="Windows 10X experience"/></Grid></StackPanel>
            <StackPanel x:Name="WindowsUpdatePanel" Margin="0,25,0,0" Visibility="Collapsed"><TextBlock FontSize="20" FontWeight="SemiBold" Text="Windows Update"/><TextBlock Margin="0,14,0,0" Text="Keep your device up to date with the latest features and security improvements."/><Button Margin="0,24,0,0" HorizontalAlignment="Left" Click="CheckForUpdates_Click"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;"/><TextBlock Text="Check for updates"/></StackPanel></Button><TextBlock x:Name="UpdateStatusText" Margin="0,14,0,0" Opacity=".7" Text="Update checks will be available in a future CoreShell update."/></StackPanel>
          </StackPanel></ScrollViewer></SplitView></Grid>
        </Grid>
        <Border x:Name="ResizeGrip" Grid.Row="1" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE76C;"/></Border>
      </Grid>
  </Border>
</UserControl>
