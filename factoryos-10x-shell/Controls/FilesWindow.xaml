<UserControl
    x:Class="factoryos_10x_shell.Controls.FilesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="900"
    Height="580">
    <UserControl.Resources>
        <Style x:Key="FilesCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" /><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#24FFFFFF" /></ObjectAnimationUsingKeyFrames></Storyboard></VisualState><VisualState x:Name="Pressed"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#3DFFFFFF" /></ObjectAnimationUsingKeyFrames></Storyboard></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><Border x:Name="Background" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" /></Border></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FilesCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource FilesCaptionButtonStyle}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#E81123" /></ObjectAnimationUsingKeyFrames></Storyboard></VisualState><VisualState x:Name="Pressed"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#C50F1F" /></ObjectAnimationUsingKeyFrames></Storyboard></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><Border x:Name="Background" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" /></Border></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="#FF5A5A5A" BorderThickness="1" CornerRadius="4">
        <Grid PointerPressed="Root_PointerPressed">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Background="#FF303030" PointerPressed="TitleBar_PointerPressed" PointerMoved="TitleBar_PointerMoved" PointerReleased="TitleBar_PointerReleased">
                <TextBlock Margin="12,0" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="Files" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Style="{StaticResource FilesCaptionButtonStyle}" Click="Minimize_Click"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White" Text="&#xE921;" /></Button>
                <Button Style="{StaticResource FilesCaptionButtonStyle}" Click="Maximize_Click"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White" Text="&#xE922;" /></Button>
                <Button Style="{StaticResource FilesCloseButtonStyle}" Click="Close_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White" Text="&#xE8BB;" />
                </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <NavigationView x:Name="LocationsNavigation"
                                AlwaysShowHeader="False"
                                CompactPaneLength="48"
                                IsBackButtonVisible="Collapsed"
                                IsPaneOpen="True"
                                IsSettingsVisible="False"
                                OpenPaneLength="180"
                                PaneDisplayMode="Left"
                                PaneTitle="Locations"
                                ItemInvoked="LocationsNavigation_ItemInvoked">
                    <NavigationView.MenuItems>
                        <NavigationViewItem x:Name="HomeNavigationItem" Content="Home" Tag="Home"><NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Downloads" Tag="Downloads"><NavigationViewItem.Icon><SymbolIcon Symbol="Download" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Documents" Tag="Documents"><NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Pictures" Tag="Pictures"><NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Videos" Tag="Videos"><NavigationViewItem.Icon><SymbolIcon Symbol="Video" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Music" Tag="Music"><NavigationViewItem.Icon><SymbolIcon Symbol="Audio" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItemSeparator />
                        <NavigationViewItem x:Name="RemovableMediaItem" Content="Removable media" Tag="Removable media"><NavigationViewItem.Icon><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE88E;" /></NavigationViewItem.Icon></NavigationViewItem>
                    </NavigationView.MenuItems>
                    <Grid Padding="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Width="32" Height="30" Padding="0" Click="Back_Click" ToolTipService.ToolTip="Back"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" /></Button>
                        <Button Width="32" Height="30" Padding="0" Click="Up_Click" ToolTipService.ToolTip="Up (..)"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74A;" /></Button>
                        <Button Width="32" Height="30" Padding="0" Click="Refresh_Click" ToolTipService.ToolTip="Refresh"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" /></Button>
                        <Button Height="30" Padding="10,0" Content="New folder" Click="NewFolder_Click" />
                        <Button Height="30" Padding="10,0" Content="Paste" Click="Paste_Click" />
                    </StackPanel>
                    <TextBlock x:Name="PathText" Grid.Row="1" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" Text="Home" />
                    <Border Grid.Row="2" Margin="0,12,0,10" Height="1" Background="#22000000" />
                    <ListView x:Name="ItemsList" Grid.Row="3" IsItemClickEnabled="True" ItemClick="ItemsList_ItemClick" SelectionMode="None">
                        <ListView.ContextFlyout>
                            <MenuFlyout Opened="ContextFlyout_Opened" Closed="ContextFlyout_Closed"><MenuFlyoutItem Text="New folder" Click="NewFolder_Click" /><MenuFlyoutItem Text="Paste" Click="Paste_Click" /></MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="42" Padding="8,0">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout Opened="ContextFlyout_Opened" Closed="ContextFlyout_Closed">
                                            <MenuFlyoutItem Text="Copy" Click="Copy_Click" />
                                            <MenuFlyoutItem Text="Cut" Click="Cut_Click" />
                                            <MenuFlyoutItem Text="Paste" Click="Paste_Click" />
                                            <MenuFlyoutItem Text="Move to..." Click="MoveTo_Click" />
                                            <MenuFlyoutItem Text="Rename" Click="Rename_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete" Click="Delete_Click" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FF3C78D8" Text="{Binding Glyph}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#FF777777" FontSize="12" Text="{Binding Kind}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </Grid>
                </NavigationView>
                <Border x:Name="ResizeGrip" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="&#xE76C;" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
