<UserControl
    x:Class="factoryos_10x_shell.Controls.FileOperationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="480" MinWidth="320">
    <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <Border Background="Transparent" PointerPressed="Title_PointerPressed" PointerMoved="Title_PointerMoved"
                        PointerReleased="Title_PointerReleased" PointerCaptureLost="Title_PointerCaptureLost">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Files/files.png" Width="18" Height="18" />
                        <TextBlock Text="Files" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                        Click="Minimize_Click" ToolTipService.ToolTip="Minimize">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE921;" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ShellCloseButtonStyle}" Click="Close_Click" ToolTipService.ToolTip="Cancel / Close">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="11" Glyph="&#xE8BB;" />
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,18,22,20" Spacing="12">
                    <TextBlock Text="{Binding Title}" FontSize="21" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Location}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" />
                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Item}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.8" />
                    <StackPanel Visibility="{Binding PasswordVisibility}" Spacing="8">
                        <PasswordBox x:Name="ArchivePassword" PlaceholderText="Archive password" />
                        <Button Content="Continue" Click="Password_Click" HorizontalAlignment="Right" />
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorDetails}" Visibility="{Binding ErrorVisibility}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <Button Content="{Binding ActionText}" IsEnabled="{Binding CanCancel}" Click="Action_Click" HorizontalAlignment="Right" MinWidth="96" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
